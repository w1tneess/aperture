# Copy to .env in the project root (never commit it). The server loads it automatically.
# PowerShell: Copy-Item .env.example .env

PORT=8787
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other devices.
HOST=127.0.0.1

# 1 = public instance anyone can use: stricter limits, cookies always ignored.
PUBLIC_MODE=0
# 1 = update yt-dlp / gallery-dl on start and daily (recommended for anything long-running).
AUTO_UPDATE=0

# Private use only (ignored when PUBLIC_MODE=1): Netscape cookies.txt from a browser where you're logged in.
# Windows example: COOKIES_FILE=C:/Users/you/aperture-cookies.txt
COOKIES_FILE=

# Instagram backup via Apify (no personal login). Free plan: $5/month credit.
APIFY_TOKEN=
# APIFY_DAILY_LIMIT=60

# Cookies used for Instagram ONLY (allowed even when PUBLIC_MODE=1). Use a throwaway account.
# On Render, upload a Secret File named instagram-cookies.txt instead; it's picked up automatically.
INSTAGRAM_COOKIES_FILE=
# Comma-separated platforms to accept. Default when PUBLIC_MODE=1: instagram,x,facebook,pinterest
ENABLED_PLATFORMS=
# Takedowns: comma-separated post IDs (or link pieces) to refuse, e.g. the Instagram code or X status number. Case-insensitive.
BLOCKED_LINKS=

# Optional passcode gate for a private instance reachable from other devices.
APP_PASSCODE=
SESSION_SECRET=

# Shown in the footer of a public instance.
CONTACT_URL=
REPO_URL=

# Limits (defaults depend on PUBLIC_MODE)
# MAX_FILESIZE=500M
# MAX_DURATION_MINUTES=90
# MAX_CONCURRENT=2
# MAX_JOBS_PER_IP=3
# JOB_TTL_MINUTES=15

# Set to 1 behind one reverse proxy (Render, nginx, Caddy) so rate limits see real visitor IPs.
TRUST_PROXY=
# Allow more yt-dlp-supported sites, comma separated (e.g. vimeo.com,soundcloud.com)
EXTRA_HOSTS=
