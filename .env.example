# Copy to .env in the project root (never commit it). The server loads it automatically.
# PowerShell: Copy-Item .env.example .env
PORT=8787
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your phone on the same Wi-Fi (set APP_PASSCODE!).
HOST=127.0.0.1
# Netscape cookies.txt exported from a browser where you're logged in. Needed for most Instagram posts.
# Windows example: COOKIES_FILE=C:/Users/you/stash-cookies.txt
COOKIES_FILE=
# Required whenever HOST is not 127.0.0.1.
APP_PASSCODE=
# Keeps you logged in across restarts. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
MAX_FILESIZE=2G
MAX_CONCURRENT=3
JOB_TTL_MINUTES=30
# Allow more yt-dlp-supported sites, comma separated (e.g. vimeo.com,soundcloud.com)
EXTRA_HOSTS=
# Set to 1 when running behind a reverse proxy (nginx, Caddy) so rate limits see real client IPs.
TRUST_PROXY=
